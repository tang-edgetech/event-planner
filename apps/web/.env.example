# Laravel API, server-side only (never exposed to the browser).
API_URL=http://127.0.0.1:8000

# What the homepage shows: "maintenance" (This site is under maintenance) or "notfound" (404).
HOME_MODE=maintenance

# Shared secret with the API (same value as INTERNAL_API_KEY in apps/api/.env). Required.
INTERNAL_API_KEY=

# The backoffice origin, allowed to show microsite previews in a frame.
BACKOFFICE_ORIGIN=http://localhost:4004
